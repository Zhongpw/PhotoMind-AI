# Offline restore config (machine-specific; references .nuget/offline)
nuget.offline.config

# Logs
logs/
*.log

# Throwaway tooling
.tools/*.zip
.tools/*.log
.tools/*.txt
.tools/*.exe
.tools/probe-*.ps1
.tools/inno-setup/
.tools/dotnet-ef/
*.heic

# Installer output (built binaries — source .iss is committed)
installer/output/
.install-test/

# Generated test images (regenerable via .tools/gen-test-images.py)
TestData/

# OS junk
Thumbs.db
Desktop.ini
.DS_Store
