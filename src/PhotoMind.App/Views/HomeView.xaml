<UserControl x:Class="PhotoMind.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">

            <TextBlock Text="首页" Style="{StaticResource PageTitle}" Margin="0,0,0,24" />

            <!-- Statistics -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="已扫描图片" Style="{StaticResource SecondaryText}" />
                        <TextBlock Text="{Binding ScannedImageCount}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="已完成 AI 分类" Style="{StaticResource SecondaryText}" />
                        <TextBlock Text="{Binding ClassifiedCount}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="待审核" Style="{StaticResource SecondaryText}" />
                        <TextBlock Text="{Binding PendingReviewCount}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="未分类" Style="{StaticResource SecondaryText}" />
                        <TextBlock Text="{Binding UnclassifiedCount}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick start -->
            <TextBlock Text="快速开始" Style="{StaticResource SectionTitle}" Margin="0,32,0,14" />
            <StackPanel Orientation="Horizontal">
                <Button Content="🖼️  扫描照片" Command="{Binding QuickScanCommand}" Margin="0,0,12,0" />
                <Button Content="⚙️  配置 API" Style="{StaticResource SecondaryButton}" Command="{Binding OpenSettingsCommand}" Margin="0,0,12,0" />
                <Button Content="🏷️  分类管理" Style="{StaticResource SecondaryButton}" Command="{Binding ManageCategoriesCommand}" />
            </StackPanel>

            <!-- Recent scan tasks -->
            <TextBlock Text="最近扫描任务" Style="{StaticResource SectionTitle}" Margin="0,32,0,14" />
            <Border Style="{StaticResource Card}">
                <ItemsControl ItemsSource="{Binding RecentScanTasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding StartedText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                                <TextBlock Grid.Column="1" Text="{Binding CountText}" Margin="16,0" FontSize="13" />
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" FontSize="13" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Recent directories -->
            <TextBlock Text="最近使用的扫描目录" Style="{StaticResource SectionTitle}" Margin="0,32,0,14" />
            <Border Style="{StaticResource Card}">
                <ItemsControl ItemsSource="{Binding RecentDirectories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,3" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
