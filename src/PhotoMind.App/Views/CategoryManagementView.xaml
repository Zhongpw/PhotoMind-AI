<UserControl x:Class="PhotoMind.App.Views.CategoryManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Controls ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="分类管理" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="名称" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="200" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" />
                    <TextBlock Text="描述" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Width="280" Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="➕ 添加一级分类" Command="{Binding AddTopLevelCommand}" Margin="0,0,8,0" />
                    <Button Content="➕ 添加子分类" Style="{StaticResource SecondaryButton}" Command="{Binding AddSubCategoryCommand}" Margin="0,0,8,0" />
                    <Button Content="✏️ 重命名" Style="{StaticResource SecondaryButton}" Command="{Binding RenameCommand}" Margin="0,0,8,0" />
                    <Button Content="🗑 删除" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="0,0,8,0" />
                    <Button Content="🔄 刷新" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- ============ Category tree ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
            <TreeView ItemsSource="{Binding TopLevelCategories}"
                      SelectedItemChanged="Tree_SelectedItemChanged"
                      Background="Transparent" BorderThickness="0">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding DisplayName}" Margin="0,4" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>
    </Grid>
</UserControl>
