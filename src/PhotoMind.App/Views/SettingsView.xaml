<UserControl x:Class="PhotoMind.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="760" HorizontalAlignment="Left">

            <!-- ============ DeepSeek API ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="DeepSeek API" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

                    <TextBlock Text="API Key" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="密钥使用 Windows DPAPI 加密后保存在本地，不会写入配置文件或日志。" Style="{StaticResource SecondaryText}" Margin="0,4,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding ApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ShowApiKey, Converter={StaticResource BoolToVisibility}}"
                                 Margin="0,0,8,0" />
                        <PasswordBox x:Name="ApiKeyPasswordBox" Grid.Column="0"
                                     PasswordChanged="OnApiKeyPasswordChanged"
                                     Visibility="{Binding ShowApiKey, Converter={StaticResource InverseBoolToVisibility}}"
                                     Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="👁 显示/隐藏" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleShowKeyCommand}" Margin="0,0,8,0" />
                        <Button Grid.Column="2" Content="保存" Command="{Binding SaveApiKeyCommand}" Margin="0,0,8,0" />
                        <Button Grid.Column="3" Content="删除" Style="{StaticResource SecondaryButton}"
                                Command="{Binding DeleteApiKeyCommand}" Margin="0,0,8,0" />
                        <Button Grid.Column="4" Content="测试连接" Style="{StaticResource SecondaryButton}"
                                Command="{Binding TestConnectionCommand}"
                                IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#999999" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionStatus}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionStatus}" Value="False">
                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ AI 分类配置 ============ -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="AI 分类配置" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="API 地址" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="模型名称" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="识别 detail" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding DetailOptions}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Detail}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="最大并发数" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ConcurrencyOptions}"
                                  SelectedItem="{Binding Concurrency}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="失败重试次数" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding MaxRetriesOptions}"
                                  SelectedItem="{Binding MaxRetries}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="预览最大边长" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding MaxPreviewDimensionOptions}"
                                  SelectedItem="{Binding MaxPreviewDimension}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="预览质量" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding PreviewQualityOptions}"
                                  SelectedItem="{Binding PreviewQuality}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="允许 AI 上传图片" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="7" Grid.Column="1" IsChecked="{Binding AllowUpload}" VerticalAlignment="Center"
                                  Content="关闭后不会把任何图片发送给 AI" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="💾 保存配置" Command="{Binding SaveConfigCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
