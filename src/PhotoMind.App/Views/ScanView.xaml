<UserControl x:Class="PhotoMind.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Settings ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="图片扫描" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: sources + exclusions -->
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="扫描来源" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                            <Button Content="📂 添加文件夹" Command="{Binding AddFolderCommand}" Margin="0,0,8,0" />
                            <ComboBox Width="150" ItemsSource="{Binding AvailableDrives}"
                                      SelectedItem="{Binding SelectedDrive}" Margin="0,0,8,0" />
                            <Button Content="💽 添加磁盘" Style="{StaticResource SecondaryButton}" Command="{Binding AddDiskCommand}" />
                        </StackPanel>
                        <ListBox Style="{StaticResource PlainListBox}" MaxHeight="120"
                                 ItemsSource="{Binding SourceDirectories}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="✕" Style="{StaticResource SecondaryButton}" Padding="6,2"
                                                Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="排除目录" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                            <Button Content="🚫 添加排除目录" Style="{StaticResource SecondaryButton}" Command="{Binding AddExcludeCommand}" />
                        </StackPanel>
                        <ListBox Style="{StaticResource PlainListBox}" MaxHeight="100"
                                 ItemsSource="{Binding ExcludedDirectories}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="✕" Style="{StaticResource SecondaryButton}" Padding="6,2"
                                                Command="{Binding DataContext.RemoveExcludeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- Right: options + actions + progress -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="扫描选项" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="递归扫描子目录" IsChecked="{Binding Recursive}" Margin="0,8,0,0" />
                        <ItemsControl ItemsSource="{Binding FormatFilters}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked}" Margin="0,0,12,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="操作" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="🔍 估算" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding EstimateCommand}"
                                    IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}" Margin="0,0,8,0" />
                            <Button Content="▶ 开始扫描"
                                    Command="{Binding StartScanCommand}"
                                    IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}" Margin="0,0,8,0" />
                            <Button Content="⏸ 暂停" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding PauseScanCommand}"
                                    IsEnabled="{Binding IsScanning}" Margin="0,0,8,0" />
                            <Button Content="▶ 继续" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ResumeScanCommand}"
                                    IsEnabled="{Binding IsPaused}" Margin="0,0,8,0" />
                            <Button Content="✕ 取消" Style="{StaticResource DangerButton}"
                                    Command="{Binding CancelScanCommand}"
                                    IsEnabled="{Binding IsScanning}" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}"
                                   TextWrapping="Wrap" Margin="0,12,0,0" />

                        <ProgressBar Margin="0,10,0,0" IsIndeterminate="{Binding IsScanning}" />

                        <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="已扫描 " /><Run Text="{Binding ScannedCount}" FontWeight="SemiBold" />
                            <Run Text=" · 总数 " /><Run Text="{Binding TotalCount}" FontWeight="SemiBold" />
                            <Run Text=" · 失败 " /><Run Text="{Binding FailedCount}" FontWeight="SemiBold" />
                            <Run Text=" · 预估 " /><Run Text="{Binding EstimatedCount}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Errors -->
                <Expander Header="扫描错误" Margin="0,12,0,0" IsExpanded="False">
                    <ListBox Style="{StaticResource PlainListBox}" MaxHeight="140" ItemsSource="{Binding Errors}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding FullPath}" FontSize="12" Foreground="{StaticResource ErrorBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Expander>
            </StackPanel>
        </Border>

        <!-- ============ Results (virtualised thumbnail list) ============ -->
        <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding Images}"
                     Background="Transparent"
                     BorderThickness="0"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.IsDeferredScrollingEnabled="True"
                     ScrollViewer.CanContentScroll="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="80" Height="80" Background="#EFEFEF" CornerRadius="4">
                                    <Grid>
                                        <TextBlock Text="🖼️" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4" />
                                        <Image Source="{Binding ThumbnailPath, Converter={StaticResource PathToImageSource}}" Stretch="Uniform" />
                                        <Border Background="#CCFFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                                Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="读取失败" FontSize="10" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding OriginalPath}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="{Binding FileSizeText}" Style="{StaticResource SecondaryText}" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding DimensionsText}" Style="{StaticResource SecondaryText}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
