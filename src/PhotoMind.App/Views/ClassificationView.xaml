<UserControl x:Class="PhotoMind.App.Views.ClassificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Controls ============ -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="AI 智能分类" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="分类模式" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="200" ItemsSource="{Binding ModeOptions}"
                              DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Mode}" Margin="0,0,16,0" />
                    <CheckBox Content="重新分类已分类图片" IsChecked="{Binding IncludeAlreadyClassified}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="▶ 开始分类" Command="{Binding StartClassifyCommand}"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" Margin="0,0,8,0" />
                    <Button Content="⏸ 暂停" Style="{StaticResource SecondaryButton}" Command="{Binding PauseClassifyCommand}"
                            IsEnabled="{Binding IsRunning}" Margin="0,0,8,0" />
                    <Button Content="▶ 继续" Style="{StaticResource SecondaryButton}" Command="{Binding ResumeClassifyCommand}"
                            IsEnabled="{Binding IsPaused}" Margin="0,0,8,0" />
                    <Button Content="✕ 取消" Style="{StaticResource DangerButton}" Command="{Binding CancelClassifyCommand}"
                            IsEnabled="{Binding IsRunning}" Margin="0,0,8,0" />
                    <Button Content="🔄 刷新" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" />
                </StackPanel>

                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,12,0,0" />
                <ProgressBar Margin="0,10,0,0" IsIndeterminate="{Binding IsRunning}" />

                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="已完成 " /><Run Text="{Binding CompletedCount}" FontWeight="SemiBold" />
                    <Run Text=" · 总数 " /><Run Text="{Binding TotalCount}" FontWeight="SemiBold" />
                    <Run Text=" · 失败 " /><Run Text="{Binding FailedCount}" FontWeight="SemiBold" />
                    <Run Text=" · 待分类 " /><Run Text="{Binding UnclassifiedCount}" FontWeight="SemiBold" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ============ Results ============ -->
        <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding Results}"
                     Background="Transparent"
                     BorderThickness="0"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.IsDeferredScrollingEnabled="True"
                     ScrollViewer.CanContentScroll="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="56" Height="56" Background="#EFEFEF" CornerRadius="4">
                                    <Grid>
                                        <TextBlock Text="🖼️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4" />
                                        <Image Source="{Binding ThumbnailPath, Converter={StaticResource PathToImageSource}}" Stretch="Uniform" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CategoryText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding ConfidenceText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <Border Background="#FFF4CE" CornerRadius="4" Padding="6,2" Margin="0,4,0,0"
                                            Visibility="{Binding NeedsReview, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="待审核" FontSize="10" Foreground="{StaticResource WarningBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
