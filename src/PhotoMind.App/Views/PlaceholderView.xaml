<UserControl x:Class="PhotoMind.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="520">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="该功能将在后续阶段开放" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="当前阶段（Phase 1）已实现首页与图片扫描。AI 智能分类、分类审核、照片整理、分类管理、历史任务与设置将在后续阶段逐步加入。"
                               Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
